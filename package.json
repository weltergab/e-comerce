{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx server/index.ts",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "lint": "eslint",
    "setup-stripe": "tsx scripts/setup-stripe-products.ts"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.4.0",
    "@supabase/supabase-js": "^2.81.1",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.554.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.10.1",
    "stripe": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
