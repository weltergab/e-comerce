{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    }
  ],
  "functions": {
    "api/tasks.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "storecy-tasks",
          "retryAfterSeconds": 30
        }
      ]
    }
  }
}
