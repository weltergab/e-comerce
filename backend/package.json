{
  "name": "lerium-shop-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server/local.ts",
    "build": "tsc --noEmit && node scripts/validate-vercel-config.mjs",
    "start": "tsx server/local.ts",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "catalog:import": "tsx scripts/import-stripe-catalog.ts",
    "tasks:backfill": "tsx scripts/backfill-background-tasks.ts",
    "test:ci": "vitest run --reporter=default --reporter=junit --reporter=json --outputFile.junit=reports/junit.xml --outputFile.json=reports/tests.json"
  },
  "dependencies": {
    "@sentry/node": "^11.0.0",
    "@supabase/supabase-js": "^2.81.1",
    "@vercel/queue": "^0.7.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "qs": "^6.16.0",
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  }
}
